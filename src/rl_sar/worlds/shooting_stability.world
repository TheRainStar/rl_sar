<?xml version="1.0" ?>
<!--
  Shooting stability range (aligned with robot_lab TargetRangeSceneQ25Cfg):
    - Flat ground, frontal red target at 100 m / 1.4 m (az=0)
    - Offset blue target at +2.5 deg (~4.36 m lateral) for non-facing aim
    - Hit zone radius 0.25 m, azimuth markers at +/-2.5 deg
    - Green ballistic reference ray on the robot Load_sh_Link (MuJoCo dynamic)
    - Gazebo shows static boards; use MuJoCo for live ray + impact + [3] toggle
  Spawn robot at origin facing +X toward the frontal target.
-->
<sdf version="1.5">
  <world name="shooting_stability">

    <physics type="ode">
      <max_step_size>0.0005</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>2000</real_time_update_rate>
      <gravity>0 0 -9.81</gravity>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>10.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <scene>
      <ambient>0.45 0.45 0.48 1</ambient>
      <background>0.35 0.50 0.70 1</background>
      <shadows>true</shadows>
      <sky>
        <clouds>
          <speed>6</speed>
        </clouds>
      </sky>
    </scene>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>5 -8 4 0 0.35 0.95</pose>
      </camera>
    </gui>

    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <model name="range_lane_visual">
      <static>true</static>
      <link name="lane">
        <pose>50 0 0.001 0 0 0</pose>
        <visual name="lane_visual">
          <geometry>
            <box>
              <size>120 8 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.55 0.52 1</ambient>
            <diffuse>0.58 0.58 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="shooting_range">
      <static>true</static>

      <link name="target_board">
        <pose>100 0 1.4 0 0 0</pose>
        <visual name="target_board_visual">
          <geometry>
            <box>
              <size>0.02 0.5 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.0 0.0 1</ambient>
            <diffuse>1.0 0.0 0.0 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Non-facing offset target at +2.5 deg (~4.36 m lateral), robot_lab azimuth envelope. -->
      <link name="target_board_offset">
        <pose>99.9048 4.3619 1.4 0 0 3.1852</pose>
        <visual name="target_board_offset_visual">
          <geometry>
            <box>
              <size>0.02 0.5 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.4 0.85 1</ambient>
            <diffuse>0.15 0.55 1.0 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="azimuth_left_marker">
        <pose>99.903 4.363 1.4 0 0 0</pose>
        <visual name="azimuth_left_visual">
          <geometry>
            <box>
              <size>0.03 0.10 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.0 0.2 0.8 0.8</ambient>
            <diffuse>0.0 0.25 1.0 0.6</diffuse>
          </material>
        </visual>
      </link>

      <link name="azimuth_right_marker">
        <pose>99.903 -4.363 1.4 0 0 0</pose>
        <visual name="azimuth_right_visual">
          <geometry>
            <box>
              <size>0.03 0.10 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.0 0.2 0.8 0.8</ambient>
            <diffuse>0.0 0.25 1.0 0.6</diffuse>
          </material>
        </visual>
      </link>

      <!-- Static bore-axis reference (MuJoCo attaches a live 100 m ray to Load_sh_Link). -->
      <link name="bullet_trajectory_reference">
        <pose>50.4 0 0.672 0 0 0</pose>
        <visual name="bullet_trajectory_visual">
          <geometry>
            <box>
              <size>100 0.05 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.0 0.8 0.0 0.5</ambient>
            <diffuse>0.0 1.0 0.0 0.35</diffuse>
          </material>
        </visual>
      </link>

      <link name="lane_centerline">
        <pose>50 0 0.006 0 0 0</pose>
        <visual name="lane_centerline_visual">
          <geometry><box><size>100 0.12 0.012</size></box></geometry>
          <material><diffuse>1.0 0.92 0.0 0.9</diffuse></material>
        </visual>
      </link>

      <link name="marker_25m">
        <pose>25 0 0.02 0 0 0</pose>
        <visual name="marker_25m_visual">
          <geometry><box><size>0.5 12 0.04</size></box></geometry>
          <material><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>
      <link name="marker_50m">
        <pose>50 0 0.02 0 0 0</pose>
        <visual name="marker_50m_visual">
          <geometry><box><size>0.5 12 0.04</size></box></geometry>
          <material><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>
      <link name="marker_75m">
        <pose>75 0 0.02 0 0 0</pose>
        <visual name="marker_75m_visual">
          <geometry><box><size>0.5 12 0.04</size></box></geometry>
          <material><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>
      <link name="marker_100m">
        <pose>100 0 0.025 0 0 0</pose>
        <visual name="marker_100m_visual">
          <geometry><box><size>0.7 12 0.05</size></box></geometry>
          <material><diffuse>1.0 0.45 0.0 0.95</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
